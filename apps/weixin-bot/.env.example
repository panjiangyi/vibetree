# weixin-bot-service .env.example
PORT=3000
API_KEY=change-me-please

# State directory. Defaults to ~/.openclaw-poc. Each account's session lives in
# <WEIXIN_STATE_DIR>/sessions/<accountId>.json; a legacy single session.json here
# is migrated in automatically on first boot (no re-QR needed).
# WEIXIN_STATE_DIR=/home/james/.openclaw-poc

# Legacy single-session file to migrate from (default: <WEIXIN_STATE_DIR>/session.json)
# WEIXIN_SESSION_FILE=

# bot_agent string sent in base_info of every protocol call
BOT_AGENT=weixin-bot-service

# CDN base for media upload/download (default below)
# WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c

# Optional inbound webhook pre-registered on EVERY account at boot
# (per-account overrides via POST /accounts/:id/webhook)
# WEBHOOK_URL=https://example.com/weixin-hook
# WEBHOOK_SECRET=

# Webhook delivery knobs
WEBHOOK_MAX_ATTEMPTS=5

# Message history is stored per-user in SQLite at
# <WEIXIN_STATE_DIR>/<accountId>.messages.db (no configuration needed).

# Initial getupdates long-poll timeout (server may override via longpolling_timeout_ms)
POLL_TIMEOUT_MS=35000

# Max inbound media size to download/decrypt (bytes)
WEIXIN_MEDIA_MAX_BYTES=104857600

LOG_LEVEL=info
